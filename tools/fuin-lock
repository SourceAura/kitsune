#!/bin/sh
# fuin-lock: capture the desktop to the runtime tmpfs, then lock.
# The lock's ground reads the capture; without one it falls back to
# the wallpaper under the same veil. The capture is overwritten at
# every lock and gone at logout.
grim "/run/user/$(id -u)/fuin-desktop.png" 2>/dev/null
exec ryoku-shell lock
